{
  "name": "indexed-database",
  "version": "1.0.0",
  "description": "A TypeScript-based IndexedDB wrapper library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:site": "npx --yes esbuild@0.24.0 src/index.ts --bundle --format=esm --target=es2020 --outfile=site/lib/indexed-database.js",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "tsc"
  },
  "keywords": [
    "indexeddb",
    "database",
    "storage",
    "typescript"
  ],
  "author": "Parsa Khosravani",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "fake-indexeddb": "^5.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/parsakhosravani/indexed-database.git"
  },
  "homepage": "https://github.com/parsakhosravani/indexed-database#readme",
  "files": [
    "dist"
  ],
  "sideEffects": false
}
